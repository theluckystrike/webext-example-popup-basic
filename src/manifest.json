{
  "manifest_version": 3,
  "name": "Popup Basic",
  "version": "1.0.0",
  "description": "A Chrome extension demonstrating a popup with button click interaction",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
